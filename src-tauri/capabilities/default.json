{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "store:default",
    {
      "identifier": "allow-quit-screensaver",
      "description": "Allow the webview to exit the Windows screensaver",
      "commands": {
        "allow": ["quit_screensaver"]
      }
    }
  ]
}
