{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MRXScreenSaver",
  "version": "0.1.18",
  "identifier": "com.mrx.screensaver",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MRX ScreenSaver",
        "url": "index.html?mode=screensaver&scene=flipclock",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "backgroundColor": "#0A0A0A",
        "backgroundThrottling": "disabled"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "Flipqlo-style flip clock screensaver",
    "longDescription": "MRX ScreenSaver — a cross-platform Flipqlo-style flip clock and starfield screensaver for Windows, macOS, and Linux.",
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libayatana-appindicator3-1"
        ]
      }
    }
  }
}
